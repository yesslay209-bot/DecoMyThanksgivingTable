# Copy to .env.local for local development.
# Supabase → Project Settings → API. The anon key is public by design; the
# rules in supabase/schema.sql are what protect the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional: where the Feedback link in the menu goes.
# VITE_FEEDBACK_URL=https://github.com/<you>/DecoMyThanksgivingTable/issues/new/choose

# Optional sign-in (see docs/DEPLOY.md, "Optional sign-in"). Off unless true.
# VITE_AUTH_ENABLED=true
# VITE_GOOGLE_SIGNIN=true
# VITE_EMAIL_SIGNIN=true
